<sdf version="1.6">
<world name="turtlebot3_maze">
<!-- 基础设置 -->
<include>
  <uri>model://ground_plane</uri>
</include>

<include>
  <uri>model://sun</uri>
</include>

<!-- 物理引擎设置 -->
<physics type="ode">
  <real_time_update_rate>1000.0</real_time_update_rate>
  <max_step_size>0.001</max_step_size>
  <real_time_factor>1</real_time_factor>
</physics>

<!-- 场景设置 -->
<scene>
  <ambient>0.4 0.4 0.4 1</ambient>
  <background>0.7 0.7 0.7 1</background>
  <shadows>true</shadows>
</scene>

<!-- 迷宫外墙 -->
<model name="wall_north">
  <static>true</static>
  <link name="link">
    <pose>0 5 0.5 0 0 0</pose>
    <collision name="collision">
      <geometry>
        <box>
          <size>10 0.2 1</size>
        </box>
      </geometry>
    </collision>
    <visual name="visual">
      <geometry>
        <box>
          <size>10 0.2 1</size>
        </box>
      </geometry>
      <material>
        <ambient>0.5 0.5 0.5 1</ambient>
        <diffuse>0.5 0.5 0.5 1</diffuse>
      </material>
    </visual>
  </link>
</model>

<model name="wall_south">
  <static>true</static>
  <link name="link">
    <pose>0 -5 0.5 0 0 0</pose>
    <collision name="collision">
      <geometry>
        <box>
          <size>10 0.2 1</size>
        </box>
      </geometry>
    </collision>
    <visual name="visual">
      <geometry>
        <box>
          <size>10 0.2 1</size>
        </box>
      </geometry>
      <material>
        <ambient>0.5 0.5 0.5 1</ambient>
        <diffuse>0.5 0.5 0.5 1</diffuse>
      </material>
    </visual>
  </link>
</model>

<model name="wall_east">
  <static>true</static>
  <link name="link">
    <pose>5 0 0.5 0 0 0</pose>
    <collision name="collision">
      <geometry>
        <box>
          <size>0.2 10 1</size>
        </box>
      </geometry>
    </collision>
    <visual name="visual">
      <geometry>
        <box>
          <size>0.2 10 1</size>
        </box>
      </geometry>
      <material>
        <ambient>0.5 0.5 0.5 1</ambient>
        <diffuse>0.5 0.5 0.5 1</diffuse>
      </material>
    </visual>
  </link>
</model>

<model name="wall_west">
  <static>true</static>
  <link name="link">
    <pose>-5 0 0.5 0 0 0</pose>
    <collision name="collision">
      <geometry>
        <box>
          <size>0.2 10 1</size>
        </box>
      </geometry>
    </collision>
    <visual name="visual">
      <geometry>
        <box>
          <size>0.2 10 1</size>
        </box>
      </geometry>
      <material>
        <ambient>0.5 0.5 0.5 1</ambient>
        <diffuse>0.5 0.5 0.5 1</diffuse>
      </material>
    </visual>
  </link>
</model>

<!-- 内部迷宫墙壁（保持不变）-->
<model name="wall_h1">
  <static>true</static>
  <link name="link">
    <pose>-2 3 0.5 0 0 0</pose>
    <collision name="collision">
      <geometry>
        <box>
          <size>4 0.2 1</size>
        </box>
      </geometry>
    </collision>
    <visual name="visual">
      <geometry>
        <box>
          <size>4 0.2 1</size>
        </box>
      </geometry>
      <material>
        <ambient>0.7 0.3 0.3 1</ambient>
        <diffuse>0.7 0.3 0.3 1</diffuse>
      </material>
    </visual>
  </link>
</model>

<model name="wall_h2">
  <static>true</static>
  <link name="link">
    <pose>2 1 0.5 0 0 0</pose>
    <collision name="collision">
      <geometry>
        <box>
          <size>4 0.2 1</size>
        </box>
      </geometry>
    </collision>
    <visual name="visual">
      <geometry>
        <box>
          <size>4 0.2 1</size>
        </box>
      </geometry>
      <material>
        <ambient>0.7 0.3 0.3 1</ambient>
        <diffuse>0.7 0.3 0.3 1</diffuse>
      </material>
    </visual>
  </link>
</model>

<model name="wall_h3">
  <static>true</static>
  <link name="link">
    <pose>-2 -1 0.5 0 0 0</pose>
    <collision name="collision">
      <geometry>
        <box>
          <size>3 0.2 1</size>
        </box>
      </geometry>
    </collision>
    <visual name="visual">
      <geometry>
        <box>
          <size>3 0.2 1</size>
        </box>
      </geometry>
      <material>
        <ambient>0.7 0.3 0.3 1</ambient>
        <diffuse>0.7 0.3 0.3 1</diffuse>
      </material>
    </visual>
  </link>
</model>

<model name="wall_h4">
  <static>true</static>
  <link name="link">
    <pose>1.5 -3 0.5 0 0 0</pose>
    <collision name="collision">
      <geometry>
        <box>
          <size>5 0.2 1</size>
        </box>
      </geometry>
    </collision>
    <visual name="visual">
      <geometry>
        <box>
          <size>5 0.2 1</size>
        </box>
      </geometry>
      <material>
        <ambient>0.7 0.3 0.3 1</ambient>
        <diffuse>0.7 0.3 0.3 1</diffuse>
      </material>
    </visual>
  </link>
</model>

<model name="wall_v1">
  <static>true</static>
  <link name="link">
    <pose>-3 -3 0.5 0 0 0</pose>
    <collision name="collision">
      <geometry>
        <box>
          <size>0.2 3 1</size>
        </box>
      </geometry>
    </collision>
    <visual name="visual">
      <geometry>
        <box>
          <size>0.2 3 1</size>
        </box>
      </geometry>
      <material>
        <ambient>0.3 0.3 0.7 1</ambient>
        <diffuse>0.3 0.3 0.7 1</diffuse>
      </material>
    </visual>
  </link>
</model>

<model name="wall_v2">
  <static>true</static>
  <link name="link">
    <pose>0 0 0.5 0 0 0</pose>
    <collision name="collision">
      <geometry>
        <box>
          <size>0.2 4 1</size>
        </box>
      </geometry>
    </collision>
    <visual name="visual">
      <geometry>
        <box>
          <size>0.2 4 1</size>
        </box>
      </geometry>
      <material>
        <ambient>0.3 0.3 0.7 1</ambient>
        <diffuse>0.3 0.3 0.7 1</diffuse>
      </material>
    </visual>
  </link>
</model>

<model name="wall_v3">
  <static>true</static>
  <link name="link">
    <pose>3 2.5 0.5 0 0 0</pose>
    <collision name="collision">
      <geometry>
        <box>
          <size>0.2 3 1</size>
        </box>
      </geometry>
    </collision>
    <visual name="visual">
      <geometry>
        <box>
          <size>0.2 3 1</size>
        </box>
      </geometry>
      <material>
        <ambient>0.3 0.3 0.7 1</ambient>
        <diffuse>0.3 0.3 0.7 1</diffuse>
      </material>
    </visual>
  </link>
</model>

<!-- 起点标记 -->
<model name="start_marker">
  <static>true</static>
  <link name="link">
    <pose>-4 -4 0.05 0 0 0</pose>
    <visual name="visual">
      <geometry>
        <cylinder>
          <radius>0.3</radius>
          <length>0.1</length>
        </cylinder>
      </geometry>
      <material>
        <ambient>0 1 0 0.8</ambient>
        <diffuse>0 1 0 0.8</diffuse>
      </material>
    </visual>
  </link>
</model>

<!-- 终点标记 -->
<model name="goal_marker">
  <static>true</static>
  <link name="link">
    <pose>4 4 0.05 0 0 0</pose>
    <visual name="visual">
      <geometry>
        <cylinder>
          <radius>0.3</radius>
          <length>0.1</length>
        </cylinder>
      </geometry>
      <material>
        <ambient>1 0 0 0.8</ambient>
        <diffuse>1 0 0 0.8</diffuse>
      </material>
    </visual>
  </link>
</model>

<!-- TurtleBot3 机器人 - 修正后的包含方式 -->


</world>
</sdf>
